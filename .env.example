PORT=3000
NODE_ENV=development
RAILWAY_SERVICE_ROLE=web

APP_URL=https://neuromap-kids.webflow.io
APP_BASE_URL=https://neuromap-kids.webflow.io
BACKEND_PUBLIC_URL=https://neuromap-backend-production-969d.up.railway.app
SUCCESS_URL=https://neuromap-kids.webflow.io/en-checkout-success
CANCEL_URL=https://neuromap-kids.webflow.io/en-checkout-cancel

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional pre-created Stripe Price IDs. Without them the backend uses its
# server-owned $7.99/$9.99 price_data catalog.
STRIPE_PRICE_STANDARD_USD=
STRIPE_PRICE_PLUS_USD=

OPENAI_API_KEY=sk-xxxxxxx
OPENAI_MODEL=gpt-4.1-mini

RESEND_API_KEY=sk-xxxxxxxxx
EMAIL_FROM=NeuroMap Kids <noreply@yourdomain.com>

ADMIN_TOKEN=change_me_admin_token
CRON_SECRET=change_me_cron_secret
OBSERVATION_LINK_SECRET=change_me_long_random_observation_secret
ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_ALERT_COOLDOWN_MINUTES=30

WORKER_CONCURRENCY=8
WORKER_IDLE_SLEEP_MS=4000
WORKER_ERROR_SLEEP_MS=5000
WORKER_STALE_REQUEUE_INTERVAL_MS=60000
WORKER_STALE_JOB_MINUTES=15
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_MAX_ATTEMPTS=4
WORKER_RETRY_BASE_SECONDS=60
WORKER_RETRY_MAX_SECONDS=900
WORKER_EXPECTED_JOB_SECONDS=90
CAMPAIGN_TARGET_REPORTS_PER_DAY=5000

INVOICE_PROVIDER=szamlazzhu
INVOICE_AUTO_CREATE=true
INVOICE_PRODUCT_NAME=NeuroMap Kids riport
INVOICE_PRODUCT_COMMENT=Egyszeri digitalis riport, online kerdoiv alapjan.
SZAMLAZZHU_AGENT_KEY=szamlaagent_xxx
SZAMLAZZHU_E_INVOICE=true
SZAMLAZZHU_DOWNLOAD_PDF=true
SZAMLAZZHU_SEND_EMAIL=true
SZAMLAZZHU_PAYMENT_METHOD=Bankkartya
SZAMLAZZHU_INVOICE_LANGUAGE=auto
SZAMLAZZHU_CURRENCY=USD
SZAMLAZZHU_VAT_RATE=AAM
SZAMLAZZHU_SELLER_NAME=NeuroMapKids Ltd.
SZAMLAZZHU_SELLER_EMAIL_REPLY_TO=info@neuromapkids.com

META_PIXEL_ID=1234567890
META_ACCESS_TOKEN=EAAB_xxx
