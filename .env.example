PORT=3000
NODE_ENV=development
# Use web on the API service and worker on the analysis worker service.
# The runtime also infers worker from a Railway service name containing "worker".
RAILWAY_SERVICE_ROLE=web
HTTP_JSON_BODY_LIMIT_BYTES=262144
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=180000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_SHUTDOWN_GRACE_MS=30000

APP_URL=https://neuromap-kids.webflow.io
APP_BASE_URL=https://neuromap-kids.webflow.io
BACKEND_PUBLIC_URL=https://neuromap-backend-production-969d.up.railway.app
CORS_ORIGINS=https://neuromap-kids.webflow.io,https://neuromapkids.com,https://www.neuromapkids.com
SUCCESS_URL=https://neuromap-kids.webflow.io/en-checkout-success
CANCEL_URL=https://neuromap-kids.webflow.io/en-checkout-cancel

# Production always enforces the documented launch gate. Every approval requires
# a durable evidence identifier or URL. PRODUCTION_CHECKOUT_ENABLED remains the
# explicit emergency kill switch. LAUNCH_GATE_ENFORCED can enable the same strict
# behavior outside production.
PRIVACY_POLICY_URL=https://www.neuromapkids.com/privacy
PRIVACY_POLICY_VERSION=2026-07-26
TERMS_URL=https://www.neuromapkids.com/terms
TERMS_VERSION=2026-07-26
CONSENT_POLICY_VERSION=2026-07-26
POLICY_EFFECTIVE_DATE=2026-07-26
CONSENT_RECEIPT_TTL_HOURS=24
DATA_CONTROLLER_NAME=NeuroMapKids Ltd.
DATA_CONTROLLER_ADDRESS=replace_with_registered_address
DATA_CONTROLLER_COUNTRY=replace_with_country
PRIVACY_CONTACT_EMAIL=privacy@neuromapkids.com
DPO_CONTACT_EMAIL=
EEA_REPRESENTATIVE=
SUPERVISORY_AUTHORITY_NAME=replace_with_lead_supervisory_authority
SUPERVISORY_AUTHORITY_URL=https://www.edpb.europa.eu/about-edpb/about-edpb/members_en
DATA_RETENTION_DAYS=90
WEBHOOK_EVENT_PAYLOAD_RETENTION_DAYS=14
LAUNCH_GATE_ENFORCED=false
PRODUCTION_CHECKOUT_ENABLED=true
LEGAL_REVIEW_APPROVED=false
LEGAL_REVIEW_EVIDENCE=
DPIA_APPROVED=false
DPIA_EVIDENCE=
CLINICAL_CONTENT_REVIEW_APPROVED=false
CLINICAL_CONTENT_REVIEW_EVIDENCE=
PRIVACY_POLICY_PUBLISHED=false
PRIVACY_POLICY_EVIDENCE=
TERMS_PUBLISHED=false
TERMS_EVIDENCE=
CONSENT_MANAGER_CONFIGURED=false
CONSENT_MANAGER_EVIDENCE=
VENDOR_DPA_REVIEWED=false
VENDOR_DPA_EVIDENCE=
SECURITY_REVIEW_APPROVED=false
SECURITY_REVIEW_EVIDENCE=

# On Railway, add DATABASE_URL as a variable reference to Postgres.DATABASE_URL.
# The private Railway hostname is preferred over the public TCP proxy.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000
DATABASE_SSL_MODE=auto
# Optional base64-encoded CA. With one present, auto mode verifies the server certificate.
DATABASE_SSL_CA_BASE64=

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_TIMEOUT_MS=20000
STRIPE_MAX_NETWORK_RETRIES=2
# Optional pre-created Stripe Price IDs. Without them the backend uses its
# server-owned $7.99/$9.99 price_data catalog.
STRIPE_PRICE_STANDARD_USD=
STRIPE_PRICE_PLUS_USD=

OPENAI_API_KEY=sk-xxxxxxx
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=8000

RESEND_API_KEY=sk-xxxxxxxxx
EMAIL_FROM=NeuroMap Kids <noreply@yourdomain.com>

ADMIN_TOKEN=change_me_admin_token
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_SESSION_BIND_IP=false
ADMIN_LEGACY_TOKEN_AUTH=false
CRON_SECRET=change_me_cron_secret
OBSERVATION_LINK_SECRET=change_me_long_random_observation_secret
ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_ALERT_COOLDOWN_MINUTES=30
ADMIN_OPERATIONAL_ALERT_MIN_LEVEL=warning
ADMIN_OPERATIONAL_ALERT_WINDOW_HOURS=24

# Campaign baseline only. Use 8 after verifying OpenAI/Resend quotas and DB pool capacity.
WORKER_CONCURRENCY=8
WORKER_IDLE_SLEEP_MS=4000
WORKER_ERROR_SLEEP_MS=5000
WORKER_STALE_REQUEUE_INTERVAL_MS=60000
WORKER_STALE_JOB_MINUTES=15
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_MAX_ATTEMPTS=4
WORKER_RETRY_BASE_SECONDS=60
WORKER_RETRY_MAX_SECONDS=900
WORKER_EXPECTED_JOB_SECONDS=90
ENGINE_LIVE_AUDIT_LIMIT=100
CAMPAIGN_TARGET_REPORTS_PER_DAY=5000

INVOICE_PROVIDER=szamlazzhu
INVOICE_AUTO_CREATE=true
INVOICE_PRODUCT_NAME=NeuroMap Kids riport
INVOICE_PRODUCT_COMMENT=Egyszeri digitalis riport, online kerdoiv alapjan.
SZAMLAZZHU_AGENT_KEY=szamlaagent_xxx
SZAMLAZZHU_E_INVOICE=true
SZAMLAZZHU_DOWNLOAD_PDF=true
SZAMLAZZHU_SEND_EMAIL=true
SZAMLAZZHU_PAYMENT_METHOD=Bankkartya
SZAMLAZZHU_INVOICE_LANGUAGE=auto
SZAMLAZZHU_CURRENCY=USD
SZAMLAZZHU_VAT_RATE=AAM
SZAMLAZZHU_SELLER_NAME=NeuroMapKids Ltd.
SZAMLAZZHU_SELLER_EMAIL_REPLY_TO=info@neuromapkids.com

META_PIXEL_ID=1234567890
META_ACCESS_TOKEN=EAAB_xxx
# Server-side advertising events are deliberately disabled for this
# sensitive child wellbeing questionnaire funnel.
MARKETING_SERVER_EVENTS_ENABLED=false
