CONSENT_POLICY_VERSION=2026-07-15
POLICY_EFFECTIVE_DATE=2026-07-15
CONSENT_RECEIPT_TTL_HOURS=24
DATA_CONTROLLER_NAME=NeuroMapKids Ltd.
DATA_CONTROLLER_ADDRESS=replace_with_registered_address
DATA_CONTROLLER_COUNTRY=replace_with_country
PRIVACY_CONTACT_EMAIL=privacy@neuromapkids.com
DPO_CONTACT_EMAIL=
EEA_REPRESENTATIVE=
